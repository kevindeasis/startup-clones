# Leave ANTHROPIC_API_KEY blank to run in mock mode (no network calls).
ANTHROPIC_API_KEY=
# Default model. Cheaper option: claude-sonnet-5-5  (never append a date suffix)
ANTHROPIC_MODEL=claude-opus-5-5
# Set to 1 to force mock mode even if a key is present
MOCK_LLM=
DATABASE_PATH=data/docketeer.db
UPLOAD_DIR=data/uploads
CHASE_AFTER_DAYS=3
INVOICE_NET_DAYS=30
PORT=8000
