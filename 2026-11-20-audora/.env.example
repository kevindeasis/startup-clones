# Optional. When absent (and LLM_MODE=auto) the app runs fully in mock mode
# using the deterministic heuristic segmenter - no network calls.
ANTHROPIC_API_KEY=

# Model used in live mode. Default: claude-opus-5-5. Cheaper option: claude-sonnet-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# auto (default) = live if ANTHROPIC_API_KEY is set, else mock | mock | live
LLM_MODE=auto

# Where story JSON files are stored (gitignored)
DATA_DIR=./data

# Port for `npm start` / `npm run dev` (Next.js reads PORT)
PORT=3000

# Optional extras
# MOCK_CHUNK_DELAY_MS=600   # artificial delay per chunk in mock mode (async path only) so progress is visible
# ALLOW_PRIVATE_URLS=1      # allow URL import from localhost/private IPs (used by the smoke test; keep off in production)
