# Optional. Absent => deterministic mock mode (no network).
ANTHROPIC_API_KEY=
# Model used in live mode.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Set to "mock" to force mock mode even when a key is present.
LLM_MODE=
# Optional comma-separated RSS feed URLs for POST /api/news/poll.
NEWS_FEEDS=
# Set to 1 to allow localhost/private URLs for article ingest (tests only).
ALLOW_PRIVATE_URLS=
# Where the JSON store lives (default ./data).
DATA_DIR=./data
